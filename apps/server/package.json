{
  "name": "@escriba/server",
  "version": "2026.08.18",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/entry.d.ts",
  "scripts": {
    "dev": "concurrently --names Server,Worker -c green,blue  \"bun run server:hot\" \"bun run worker\"",
    "start": "concurrently --names Server,Worker -c green,blue  \"bun run server\" \"bun run worker\"",
    "server": "bun run index",
    "server:hot": "bun run --hot index",
    "worker": "bunx @openworkflow/cli worker start",
    "build": "bunx rslib build --tsconfig tsconfig.build.json",
    "schema:generate": "drizzle-kit generate && bun run seed"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/bun": "^1.4.0",
    "@types/mime-types": "^3.0.1",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.2",
    "@libsql/client": "^0.17.4",
    "@openworkflow/cli": "^0.4.5",
    "@prettier/plugin-xml": "^3.4.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.7.2",
    "concurrently": "^9.2.4",
    "drizzle-orm": "^0.45.2",
    "mime-types": "^3.0.2",
    "openworkflow": "^0.9.2",
    "prettier": "^3.9.6",
    "zod": "^4.5.4"
  }
}
